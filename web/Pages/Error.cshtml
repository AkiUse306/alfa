@page "/Error"
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Alfa Dashboard Error</title>
    <style>
        body { margin: 0; font-family: Inter, system-ui, sans-serif; background: #111827; color: #f8fafc; display: flex; align-items: center; justify-content: center; height: 100vh; }
        .panel { padding: 40px; border-radius: 24px; background: rgba(15, 23, 42, 0.95); box-shadow: 0 24px 80px rgba(0,0,0,0.25); max-width: 520px; }
        h1 { margin: 0 0 16px; font-size: 2rem; }
        p { margin: 0; color: #cbd5e1; }
    </style>
</head>
<body>
    <div class="panel">
        <h1>Something went wrong</h1>
        <p>Alfa dashboard encountered an unexpected error. Please try again later.</p>
    </div>
</body>
</html>
